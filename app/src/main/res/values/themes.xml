<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.QiblaSalahTimes" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="colorPrimary">@color/g_blue</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#1E40AF</item>
        <item name="colorOnPrimaryContainer">#E0EAFF</item>
        <item name="colorSecondary">@color/g_green</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#065F46</item>
        <item name="colorOnSecondaryContainer">#E5FFE9</item>
        <item name="colorTertiary">@color/neon_violet</item>
        <item name="colorSurface">@color/bg_card_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorSurfaceVariant">@color/bg_card_light_alt</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
        <item name="bottomNavigationStyle">@style/BottomNav.Modern</item>
        <item name="materialCardViewStyle">@style/Card.Modern</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.QiblaSalahTimes.NoActionBar" parent="Theme.QiblaSalahTimes"/>

    <style name="BottomNav.Modern" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/BottomNavIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">12dp</item>
    </style>
    <style name="BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">64dp</item>
        <item name="android:height">36dp</item>
        <item name="android:color">#1A73E8</item>
        <item name="marginHorizontal">8dp</item>
        <item name="shapeAppearance">@style/IndicatorShape</item>
    </style>
    <style name="IndicatorShape" parent="">
        <item name="cornerSize">100dp</item>
    </style>

    <style name="Card.Modern" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <style name="HeadingXL">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="HeadingL">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Heading">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>
    <style name="Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>
    <style name="Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:alpha">0.7</item>
    </style>

    <style name="Pill">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
</resources>
