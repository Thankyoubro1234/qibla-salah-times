<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView android:id="@+id/tv_ramadan_day"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="22sp" android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView android:id="@+id/tv_countdown_label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:alpha="0.85"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="22dp" app:cardBackgroundColor="@color/google_green"
            android:layout_marginBottom="20dp">
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="24dp">
                <TextView android:id="@+id/tv_big_countdown"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--:--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="56sp"
                    android:textStyle="bold"/>
                <TextView android:id="@+id/tv_iftar_time"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#E5FFE9" android:textSize="16sp"
                    android:layout_marginTop="6dp" android:text="Iftar at --:--"/>
                <TextView android:id="@+id/tv_suhoor_time"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#E5FFE9" android:textSize="16sp"
                    android:layout_marginTop="2dp" android:text="Suhoor ends at --:--"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="22dp"
            android:layout_marginBottom="20dp">
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="22dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Today's Ramadan check in"
                    android:textSize="18sp" android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>
                <CheckBox android:id="@+id/cb_fasted"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/fasted_today"
                    android:textSize="16sp"/>
                <CheckBox android:id="@+id/cb_sadaqah"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/sadaqah_given"
                    android:textSize="16sp"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/taraweeh_rakaat"
                    android:layout_marginTop="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_taraweeh"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/quran_pages"
                    android:layout_marginTop="6dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_quran_pages"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_ramadan"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="@string/save"
                    android:layout_marginTop="14dp"
                    app:cornerRadius="28dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
