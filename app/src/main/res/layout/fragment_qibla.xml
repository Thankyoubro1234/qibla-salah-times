<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:paddingTop="32dp"
        android:gravity="center_horizontal">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/qibla_title"
            style="@style/HeadingL"
            android:textColor="?android:attr/textColorPrimary"/>

        <TextView android:id="@+id/tv_accuracy"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            style="@style/Caption"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="6dp"
            android:gravity="center" android:text="@string/qibla_calibration_needed"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="28dp" app:cardElevation="6dp"
            android:layout_marginTop="22dp">
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="22dp" android:gravity="center_horizontal">

                <com.prayerpilot.app.ui.QiblaCompassView
                    android:id="@+id/compass"
                    android:layout_width="320dp" android:layout_height="320dp"/>

                <LinearLayout android:orientation="horizontal"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">
                    <View android:layout_width="12dp" android:layout_height="12dp"
                        android:background="@drawable/dot_neon"/>
                    <TextView android:id="@+id/tv_bearing"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        style="@style/HeadingL"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>

                <TextView android:id="@+id/tv_distance"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/Body"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>

                <TextView android:id="@+id/tv_calibration_status"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/Caption"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_recalibrate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="Recalibrate"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_refresh"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            style="@style/Caption"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary"
            android:text="Tip: hold the phone flat and away from metal or magnets for best accuracy."/>

    </LinearLayout>
</ScrollView>
