<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="14dp" app:cardElevation="2dp">
    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="18dp">

        <TextView android:id="@+id/tv_v_number"
            android:layout_width="32dp" android:layout_height="32dp"
            android:gravity="center"
            android:textSize="13sp" android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/surah_number_bg"
            android:layout_marginBottom="10dp"/>

        <TextView android:id="@+id/tv_v_arabic"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textDirection="rtl"
            android:gravity="end"
            android:lineSpacingExtra="10sp"/>

        <TextView android:id="@+id/tv_v_english"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:alpha="0.85"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
