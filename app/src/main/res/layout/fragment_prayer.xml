<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:paddingTop="32dp">

        <!-- Header -->
        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">
            <TextView android:id="@+id/tv_today"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/HeadingL"
                android:textColor="?android:attr/textColorPrimary"/>
            <TextView android:id="@+id/tv_hijri"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/Body"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="2dp"/>
            <TextView android:id="@+id/tv_location"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/Caption"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"/>
        </LinearLayout>

        <!-- Hero countdown card -->
        <FrameLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_blue"
            android:layout_marginBottom="22dp">
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="26dp">
                <LinearLayout android:orientation="horizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <View android:layout_width="10dp" android:layout_height="10dp"
                        android:background="@drawable/dot_neon"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tv_next_label"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Next: Fajr"
                        android:textColor="#CCEAFF"
                        android:textSize="14sp"
                        android:letterSpacing="0.04"
                        android:textStyle="bold"/>
                    <TextView android:id="@+id/tv_next_time"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:text="--:--"/>
                </LinearLayout>
                <TextView android:id="@+id/tv_countdown"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--:--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="60sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.04"
                    android:layout_marginTop="6dp"/>
                <TextView android:id="@+id/tv_countdown_sub"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="hours minutes seconds remaining"
                    android:textColor="#A8C9FF"
                    android:textSize="11sp"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="-4dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Prayer cards -->
        <LinearLayout android:id="@+id/prayer_list"
            android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
