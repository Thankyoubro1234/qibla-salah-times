<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp">
    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout android:orientation="horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView android:id="@+id/tv_v_number"
                android:layout_width="34dp" android:layout_height="34dp"
                android:gravity="center"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/surah_number_bg"/>

            <Space android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <ImageView android:id="@+id/btn_copy"
                android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_copy"
                android:padding="4dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Copy"/>
            <ImageView android:id="@+id/btn_share"
                android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_share"
                android:padding="4dp"
                android:contentDescription="Share"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_v_arabic"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textDirection="rtl"
            android:gravity="end"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="14sp"/>

        <TextView android:id="@+id/tv_v_english"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:alpha="0.85"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
